# Edge Function secrets. Configure with `supabase secrets set --env-file supabase/.env.local`.
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_API_KEY="your-provider-api-key"
AI_MODEL="your-openai-compatible-model"

# Supabase injects these automatically in hosted Edge Functions.
# SUPABASE_URL=
